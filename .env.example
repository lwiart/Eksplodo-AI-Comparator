NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173
DATABASE_URL=mysql://root:test@127.0.0.1:3307/aic
DATA_DIR=./data
# Clé maîtresse qui chiffre les clés des fournisseurs saisies dans l'interface (32 octets en base64).
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ne jamais la changer après coup : les clés déjà enregistrées deviendraient illisibles.
APP_ENCRYPTION_KEY=
# Au moins 32 caractères (valeur factice : à remplacer)
CRON_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-ou-plus
# SMTP : tous les champs ou aucun
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Premier administrateur (les deux ou aucun ; mot de passe de 12 caractères minimum)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Faux fournisseur : développement sans clé ni dépense (ignoré en production)
# AIC_FAKE_LLM=1
